# ── 서버 ──
PORT=8080
PUBLIC_URL=http://localhost:8080      # BFF 공개 URL(OAuth 콜백·이메일 인증 링크 구성)

# ── 도원 추론 서버 (내부망, 무인증) ──
# ⚠ 이 서버는 공개 노출 금지. BFF만 공개 엣지.
INFERENCE_BASE_URL=http://127.0.0.1:8000
INFERENCE_SERVICE_TOKEN=              # 추론 서버에 서비스 토큰을 둘 경우(선택)

# ── 인증(JWT) ──
JWT_SECRET=dev-only-change-me         # ⚠ 실제 시크릿은 .env에(커밋 금지)
ACCESS_TOKEN_TTL=900                  # access 만료(초) = 15분
REFRESH_TOKEN_TTL=1209600             # refresh 만료(초) = 14일
EMAIL_VERIFY_TTL=86400                # 이메일 인증 토큰 만료(초) = 24시간

# ── BFF 전용 DB(유저·refresh·Job) ──
# ⚠ 추론 라이브러리 poses.db와 다른 파일. PII 분리.
DB_PATH=data/bff.db

# ── 소셜 로그인 (키는 각 개발자 콘솔에서 발급) ──
# 각 provider 콘솔에 등록할 Redirect URI: {PUBLIC_URL}/v1/auth/oauth/{provider}/callback
#   구글  → http://localhost:8080/v1/auth/oauth/google/callback
#   카카오 → http://localhost:8080/v1/auth/oauth/kakao/callback
#   네이버 → http://localhost:8080/v1/auth/oauth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=                      # 카카오 REST API 키
KAKAO_CLIENT_SECRET=                  # (선택) 카카오 Client Secret 활성화 시
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 로그인 성공 후 토큰을 넘길 클라 리디렉트(데스크톱 딥링크 등). 비우면 콜백이 JSON 반환.
OAUTH_SUCCESS_REDIRECT=

# ── 이메일 인증 발송(SMTP) — 비우면 dev에서 콘솔에 인증 링크 출력 ──
SMTP_HOST=                            # 예: smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Standin <no-reply@standin.local>
