# ── 서버 ──
PORT=8080

# ── 도원 추론 서버 (내부망, 무인증) ──
# ⚠ 이 서버는 공개 노출 금지. BFF만 공개 엣지.
INFERENCE_BASE_URL=http://127.0.0.1:8000
INFERENCE_SERVICE_TOKEN=              # 추론 서버에 서비스 토큰을 둘 경우(선택)

# ── 인증(JWT) — Phase 1 ──
JWT_SECRET=dev-only-change-me         # ⚠ 실제 시크릿은 .env에(커밋 금지)
ACCESS_TOKEN_TTL=900                  # access 만료(초) = 15분
REFRESH_TOKEN_TTL=1209600             # refresh 만료(초) = 14일

# ── BFF 전용 DB(유저·Job) ──
# ⚠ 추론 라이브러리 poses.db와 다른 파일. PII 분리.
DB_PATH=data/bff.db
